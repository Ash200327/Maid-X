# Backend Environment Variables
SPRING_PROFILES_ACTIVE=local
PORT=8080

# Database (PostgreSQL / Neon)
DATABASE_URL=jdbc:postgresql://localhost:5432/maid_manager
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Security & JWT (use strong secrets in staging/production)
JWT_ACCESS_SECRET=replace-with-a-very-strong-256-bit-secret-key-in-production!
JWT_REFRESH_SECRET=replace-with-another-very-strong-256-bit-secret-key-in-production!
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# App Defaults
APP_DEFAULT_TIMEZONE=Asia/Kolkata
APP_DEFAULT_CURRENCY=INR
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,exp://*
